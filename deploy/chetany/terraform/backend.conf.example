# Copy to backend.conf and fill in the real values (ask the ethPandaOps team).
# backend.conf is gitignored on purpose — never commit it.
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
region                      = "us-east-1"
endpoints                   = { s3 = "<spaces-endpoint-url>" }
bucket                      = "<state-bucket-name>"
key                         = "<state-key-path>/terraform.tfstate"
