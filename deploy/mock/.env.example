# Copy to .env (docker compose loads it automatically) and fill these in.

# Beacon API (consensus) endpoint proofessoor reads blocks from. Required.
BEACON_URL=https://your-beacon-api

# Local zkBoost config containing your EL endpoint and any auth headers.
# Copy zkboost.toml to this ignored file before editing it.
ZKBOOST_CONFIG=./zkboost.local.toml

# Optional zkBoost image override. Trace propagation, authenticated EL headers,
# and failure replay require an image containing those extensions.
# ZKBOOST_IMAGE=your-registry/zkboost:your-tag

# Optional execution genesis config for ELs that do not serve debug_chainConfig.
# Add ../docker-compose.chain-config.yml to the compose command when using this.
# ZKBOOST_CHAIN_CONFIG=./hoodi_chain_config.json

# Optional: extra Beacon API header for authenticated providers, "Name: Value".
# BEACON_HEADER=X-API-Key: your-key

# Host port for the proofessoor dashboard (the container always serves :9100).
# Override if 19100 is already taken on your host.
PROOFESSOOR_PORT=19100
